# Boya textbook slides used as source material when importing vocabulary and grammar lessons:
# 105 MB of copyrighted PDFs. No Java code reads them — the import was a one-off run of a script
# against this folder — so they are kept on disk and out of the repository.
src/main/resources/slide/

# Build output, not source: deploy/build.ps1 deletes this folder and refills it from
# learnE-Frontend/dist on every build.
src/main/resources/static/

